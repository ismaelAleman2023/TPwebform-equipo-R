<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Principal.Master.cs" Inherits="tpc_webform_grupo_R.Site1" %>

<!DOCTYPE html>

<html>

<head runat="server">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>V.Dorrego Design</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome para los iconos de Login, Carrito y Redes -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <link href="Content/estilos.css" rel="stylesheet" type="text/css" />



    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

</head>

<body>
    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server"></asp:ScriptManager>


        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom sticky-top">
            <div class="navbar-layout container-fluid px-3">

                <!--LOGO IMAGEN A LA IZQUIERDA-->
                <div class="logo-container ">
                    <a href="Default.aspx">
                        <img runat="server" src="~/images/icons/dorregoDesign.png" alt="V.Dorrego Design" class="logo-img imgLogo" />
                    </a>
                </div>

                <!-- GRUPO DERECHO (CELULAR: ARRIBA / PC: SU LUGAR ORIGINAL) -->
                <div class="d-flex align-items-center flex-wrap gap-2 order-lg-3 barra-opciones">

                    <!-- DESPLEGABLE ADMINISTRADOR -->
                    <asp:Panel ID="pnlMenuAdmin" runat="server" CssClass="nav-item dropdown d-inline-block" Visible="false" Style="display: inline-flex; align-items: center;">
                        <a class="nav-link dropdown-toggle nav-cajita text-warning fw-bold " href="#" id="navbarDropdownAdmin" role="button" data-bs-toggle="dropdown" aria-expanded="false">Administrar
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end " aria-labelledby="navbarDropdownAdmin">
                            <li>
                                <asp:LinkButton ID="lnkAdministrar" runat="server" CommandArgument="b8" OnClick="btnBar_click" CssClass="dropdown-item">Administrar</asp:LinkButton>
                            </li>
                            <li>
                                <asp:LinkButton ID="lnkAdminPedidosDropdown" runat="server" CommandArgument="b11" OnClick="btnBar_click" CssClass="dropdown-item">Administrar Pedidos</asp:LinkButton>
                            </li>
                            <li>
                                <asp:LinkButton ID="lnkInformes" runat="server" CommandArgument="b9" OnClick="btnBar_click" CssClass="dropdown-item">Informes</asp:LinkButton>
                            </li>
                        </ul>
                    </asp:Panel>

                    <asp:Button Id="btnCerrarSession" Text="Cerrar Session" runat="server" OnClick="btnCerrarSession_Click" CssClass="btn btn-warning btn-xs me-2 my-auto"/>
                    <!-- LOGIN / PERFIL -->
                    <asp:LinkButton ID="lnkLogin" runat="server" OnClick="lnkLogin_Click" CssClass="action-item text-decoration-none d-flex align-items-center">
                        <asp:Image ID="imgUserPerfil" runat="server" CssClass="rounded-circle shadow-sm mb-2" Style="width: 35px; height: 35px; object-fit: cover;" />
                        <span class="action-label ms-1" id="lblLogin" runat="server"></span>
                    </asp:LinkButton>

                    <!-- CARRITO -->
                    <asp:HyperLink ID="lnkCarrito" runat="server" NavigateUrl="~/Carrito.aspx" CssClass="action-item ms-1">
                        <div class="carrito-circulo">
                            <i class="fa-solid fa-cart-shopping mt-1"></i>
                            <div class="circulo-contador">
                                <asp:Label ID="lblContadorCarrito" CssClass="contador-Carrito" runat="server" Style="font-size: 0.9rem; font-weight: 700; font-family: Arial, sans-serif"></asp:Label>
                            </div>
                        </div>
                        <span class="action-label micarrito">Mi carrito</span>
                    </asp:HyperLink>

                    <!-- BOTÓN HAMBURGUESA (SOLO APARECE EN CELULAR) -->
                    <button class="navbar-toggler ms-2 d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                </div>

                <!--CONTENEDOR DESPLEGABLE (LAS CAJITAS CENTRALES DE NAVEGACIÓN)-->
                <div class="collapse navbar-collapse justify-content-center order-lg-2" id="navbarContent">
                    <div class="nav-cajitas-wrapper">
                        <asp:LinkButton ID="lnkDestacados" runat="server" CommandArgument="b1" OnClick="btnBar_click" CssClass="nav-cajita">Destacados</asp:LinkButton>
                        <asp:LinkButton ID="lnkProductos" runat="server" CommandArgument="b2" OnClick="btnBar_click" CssClass="nav-cajita">Catalogo</asp:LinkButton>
                        <asp:LinkButton ID="lnkNovedades" runat="server" CommandArgument="b3" OnClick="btnBar_click" CssClass="nav-cajita">Novedades</asp:LinkButton>
                        <asp:LinkButton ID="lnkSobreNosotros" runat="server" CommandArgument="b4" OnClick="btnBar_click" CssClass="nav-cajita">Sobre nosotros</asp:LinkButton>
                        <asp:LinkButton ID="lnkComoComprar" runat="server" CommandArgument="b5" OnClick="btnBar_click" CssClass="nav-cajita">Como comprar</asp:LinkButton>
                        <asp:LinkButton ID="lnkContactanos" runat="server" CommandArgument="b6" OnClick="btnBar_click" CssClass="nav-cajita">Contactanos</asp:LinkButton>
                        <asp:LinkButton ID="lnkPerfil" runat="server" CommandArgument="b7" OnClick="btnBar_click" CssClass="nav-cajita">Perfil</asp:LinkButton>
                        <asp:LinkButton ID="LnkMisPedidos" runat="server" CommandArgument="b10" OnClick="btnBar_click" CssClass="nav-cajita">Mis Pedidos</asp:LinkButton>


                    </div>
                </div>

            </div>
        </nav>

        <div class="Content">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </form>







    <footer class="bg-dark text-light pt-4 pb-3 mt-auto">
        <div class="container">
            <div class="row">


                <div class="col-md-4 mb-3 mb-md-1">
                    <asp:Label runat="server" Text="Label">siguenos </asp:Label>

                    <asp:Image ID="Image1" src="images/icons/face.png" runat="server" Height="30px" />
                    <asp:Image ID="Image2" src="images/icons/insta.png" runat="server" Height="30px" Style="margin-left: 10px" />
                    <asp:Image ID="Image3" src="images/icons/whatsap.png" runat="server" Height="37px" Style="margin-left: 10px" />
                </div>


            </div>

            <hr class="bg-secondary my-1" />

            <div class="row align-items-center">
                <div class="col-md-12 text-center small text-white">
                    &copy; <%: DateTime.Now.Year %> - V.DorregoDesign Todos los derechos reservados.
                </div>
            </div>
        </div>
    </footer>

    <div id="contenedorAlerta" class="position-fixed top-50 start-50 translate-middle p-3" style="z-index: 1050; display: none;">
        <div id="miAlerta" class="toast align-items-center text-white bg-dark border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div id="textoAlerta" class="toast-body fw-semibold px-4 py-3">
                    <!-- Aquí se inyecta el mensaje dinámicamente -->
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="Scripts/CartelFlotante.js"></script>


</body>
</html>
