<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Principal.Master.cs" Inherits="tpc_webform_grupo_R.Site1" %>

<!DOCTYPE html>

<html>

<head runat="server">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <title>V.Dorrego Design</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome para los iconos de Login, Carrito y Redes -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
    
    <link href="Content/estilos.css" rel="stylesheet" type="text/css" />

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server"></asp:ScriptManager>   
    
        <!--NAVBAR-->
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom sticky-top">
            <div class="navbar-layout container-fluid px-3">
                
                <!--LOGO IMAGEN A LA IZQUIERDA-->
                <div class="logo-container">
                    <a href="Default.aspx">
                        <img runat="server" src="~/images/icons/dorregoDesign.png" alt="V.Dorrego Design" class="logo-img" />
                    </a>
                </div>

                <!--BOTÓN HAMBURGUESA BLANCO (CELULAR)-->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!--CONTENEDOR DESPLEGABLE-->
                <div class="collapse navbar-collapse justify-content-center" id="navbarContent">
                    <!--BOTONES CENTRALES EN CAJITAS-->
                    <div class="nav-cajitas-wrapper">
                        <asp:HyperLink ID="lnkProductos" runat="server" NavigateUrl="~/" CssClass="nav-cajita">Catalogo</asp:HyperLink>
                        <asp:HyperLink ID="lnkDestacados" runat="server" NavigateUrl="~/" CssClass="nav-cajita">Destacados</asp:HyperLink>
                        <asp:HyperLink ID="lnkNovedades" runat="server" NavigateUrl="~/" CssClass="nav-cajita">Novedades</asp:HyperLink>
                        <asp:HyperLink ID="lnkSobreNosotros" runat="server" NavigateUrl="~/" CssClass="nav-cajita">Sobre nosotros</asp:HyperLink>
                        <asp:HyperLink ID="lnkComoComprar" runat="server" NavigateUrl="~/" CssClass="nav-cajita">Como comprar</asp:HyperLink>
                        <asp:HyperLink ID="lnkContactanos" runat="server" NavigateUrl="~/Contactanos.aspx" CssClass="nav-cajita">Contactanos</asp:HyperLink>
                        <asp:HyperLink ID="lnkAdministrar" runat="server" NavigateUrl="~/Administrar.aspx" CssClass="nav-cajita">Administrar</asp:HyperLink>
                    </div>
                </div>

                <!--LOGIN Y CARRITO ESCRITORIO (PC) -->
                <div class="nav-actions-wrapper d-none d-lg-flex">
                    <asp:HyperLink ID="lnkLogin" runat="server" NavigateUrl="~/Login.aspx" CssClass="action-item">
                        <i class="fa-solid fa-circle-user"></i>
                        <span class="action-label">Login</span>
                    </asp:HyperLink>

                    <asp:HyperLink ID="lnkCarrito" runat="server" NavigateUrl="~/" CssClass="action-item">
                        <div class="carrito-circulo">
                            <i class="fa-solid fa-cart-shopping"></i>
                            <span class="carrito-badge-num">0</span>
                        </div>
                        <span class="action-label mt-1">Mi carrito</span>
                    </asp:HyperLink>
                </div>

            </div>
        </nav>
      
        <div class="Content">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </form>

    <footer class="bg-dark text-light pt-4 pb-3 mt-auto">
        <div class="container">
            <div class="row">
              

                <div class="col-md-4 mb-3 mb-md-1">
                    <asp:Label runat="server" Text="Label">siguenos </asp:Label>
                    
                    <asp:Image ID="Image1" src="images/icons/face.png" runat="server" Height="30px" />
                    <asp:Image ID="Image2" src="images/icons/insta.png" runat="server" Height="30px" Style="margin-left: 10px" />
                    <asp:Image ID="Image3" src="images/icons/whatsap.png" runat="server" Height="37px" Style="margin-left: 10px" />
                </div>

                
            </div>

            <hr class="bg-secondary my-1" />

            <div class="row align-items-center">
                <div class="col-md-12 text-center small text-white">
                    &copy; <%: DateTime.Now.Year %> - V.DorregoDesign Todos los derechos reservados.
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>