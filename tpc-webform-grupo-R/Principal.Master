<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Principal.Master.cs" Inherits="tpc_webform_grupo_R.Site1" %>

<!DOCTYPE html>

<html>

<head runat="server">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <title>V.Dorrego Design</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome para los iconos de Login, Carrito y Redes -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <link href="Content/estilos.css" rel="stylesheet" type="text/css" />



    
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

</head>
<body>
    <form id="form1" runat="server">
    
       <!--NAVBAR-->
    <nav class="navbar navbar-custom sticky-top">
        <div class="navbar-layout">
            
            <!--LOGO IMAGEN A LA IZQUIERDA-->
       <div class="logo-container">
    <a href="Default.aspx">
        <img runat="server" src="~/images/icons/dorregoDesign.png" alt="V.Dorrego Design" class="logo-img" />
    </a>
</div>
            <!--BOTONES CENTRALES EN CAJITAS-->
            <div class="nav-cajitas-wrapper">
                <asp:HyperLink ID="lnkProductos" runat="server" NavigateUrl="~/" CssClass="nav-cajita active">Productos</asp:HyperLink>
                <asp:HyperLink ID="lnkDestacados" runat="server" NavigateUrl="~/" CssClass="nav-cajita">Destacados</asp:HyperLink>
                <asp:HyperLink ID="lnkNovedades" runat="server" NavigateUrl="~/" CssClass="nav-cajita">Novedades</asp:HyperLink>
                <asp:HyperLink ID="lnkSobreNosotros" runat="server" NavigateUrl="~/" CssClass="nav-cajita">Sobre nosotros</asp:HyperLink>
                <asp:HyperLink ID="lnkComoComprar" runat="server" NavigateUrl="~/" CssClass="nav-cajita">Como comprar</asp:HyperLink>
                <asp:HyperLink ID="lnkContactanos" runat="server" NavigateUrl="~/" CssClass="nav-cajita">Contactanos</asp:HyperLink>
            </div>

            <!--LOGIN Y CARRITO DERECHA -->
            <div class="nav-actions-wrapper">
                
                <asp:HyperLink ID="lnkLogin" runat="server" NavigateUrl="~/RegistroCliente.aspx" CssClass="action-item">
                    <i class="fa-solid fa-circle-user"></i>
                    <span class="action-label">Login</span>
                    
                </asp:HyperLink>

               
                <asp:HyperLink ID="lnkCarrito" runat="server" NavigateUrl="~/" CssClass="action-item">
                    <div class="carrito-circulo">
                        <i class="fa-solid fa-cart-shopping"></i>
                        <span class="carrito-badge-num">0</span>
                    </div>
                    <span class="action-label mt-1">Mi carrito</span>
                </asp:HyperLink>
            </div>

        </div>
    </nav>
     
        <div class="Content">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
